<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobileapps_NASA_API.ImageDetailPage"
             Title="ImageDetailPage">
    <ScrollView>
        <VerticalStackLayout>
            <Image Source="{Binding ImageUrl}"
                   Aspect="AspectFit"
                   HeightRequest="500"/>
                <Label Text="{Binding TitleWithDate}"
                   FontSize="22"
                   FontAttributes="Bold"/>
                <Label Text="{Binding Description}"
                       FontSize="16"
                       TextColor="Black"/>
        </VerticalStackLayout>
    </ScrollView>


</ContentPage>