<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobileapps_NASA_API.MainPage">


    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Image Source="nasa_logo.png"
               Grid.Row="0"
               Grid.Column="0"
               HeightRequest="60"
               WidthRequest="60"
               HorizontalOptions="Start"
               VerticalOptions="Center"
               Aspect="AspectFit"/>
     
            <Button x:Name="Recent_button"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="Recent"
                    HeightRequest="50"
                    Clicked="Recent_Button_Clicked"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    BackgroundColor="#003c92"
                    />
        <Button x:Name="Popular_button"
                Grid.Row="0"
                Grid.Column="2"
                Text="Popular"
                HeightRequest="50"
                Clicked="Popular_button_Clicked"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                BackgroundColor="#003c92"
                />

        <SearchBar x:Name="SearchInput"
                       Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Placeholder="Search..."
                       SearchButtonPressed="SearchInput_SearchButtonPressed"/>


        <CollectionView x:Name="NASACollection"
                Grid.Row="2"
                Grid.ColumnSpan="3">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid HeightRequest="{Binding Source={x:Reference NASACollection}, Path=Height}">

                        <!-- FULL SCREEN IMAGE -->
                        <Image Source="{Binding ImageUrl}"
                       Aspect="AspectFill"
                       VerticalOptions="Fill"
                       HorizontalOptions="Fill"/>

                        <!-- DARK OVERLAY -->
                        <BoxView Color="Black"
                         Opacity="0.35"
                         VerticalOptions="Fill"
                         HorizontalOptions="Fill"/>

                        <!-- TEXT OVERLAY -->
                        <VerticalStackLayout Padding="20"
                                     VerticalOptions="End">

                            <Label Text="{Binding TitleWithDate}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           MaxLines="2"/>

                            <Label Text="{Binding Description}"
                           FontSize="12"
                           TextColor="White"
                           MaxLines="3"/>

                            <Button Text="Save"
                             Clicked="SaveButton_Clicked"
                             BackgroundColor="#003c92"
                             TextColor="White"
                             FontSize="12"
                             HorizontalOptions="Start"
                             Padding="10,5"/>
                        </VerticalStackLayout>

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
