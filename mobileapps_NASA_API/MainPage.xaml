<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="mobileapps_NASA_API.MainPage"
    Title="NASA Browser">


    <Grid Padding="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TOP BAR -->
        <HorizontalStackLayout
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Spacing="10">

            <Image Source="nasa_logo.png"
                   HeightRequest="60"
                   WidthRequest="60"
                   Aspect="AspectFit"/>

            <Button x:Name="Recent_button"
                    Text="Recent"
                    Clicked="Recent_Button_Clicked"
                    BackgroundColor="#003c92"
                    TextColor="White"/>

            <Button x:Name="Popular_button"
                    Text="Popular"
                    Clicked="Popular_button_Clicked"
                    BackgroundColor="#003c92"
                    TextColor="White"/>

        </HorizontalStackLayout>

        <!-- COLLECTION -->
        <CollectionView x:Name="NASACollection"
                        Grid.Row="1"
                        Grid.ColumnSpan="2">

            <!-- VISUAL STATE MANAGER -->
            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup>

                    <!-- PORTRAIT -->
                    <VisualState x:Name="Portrait">

                        <VisualState.StateTriggers>
                            <OrientationStateTrigger Orientation="Portrait"/>
                        </VisualState.StateTriggers>

                        <VisualState.Setters>

                            <Setter Property="ItemsLayout">
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="15"/>
                            </Setter>

                        </VisualState.Setters>

                    </VisualState>

                    <!-- LANDSCAPE -->
                    <VisualState x:Name="Landscape">

                        <VisualState.StateTriggers>
                            <OrientationStateTrigger Orientation="Landscape"/>
                        </VisualState.StateTriggers>

                        <VisualState.Setters>

                            <Setter Property="ItemsLayout">

                                <GridItemsLayout Orientation="Vertical"
                                                 Span="2"
                                                 VerticalItemSpacing="15"
                                                 HorizontalItemSpacing="15"/>

                            </Setter>

                        </VisualState.Setters>

                    </VisualState>

                </VisualStateGroup>

            </VisualStateManager.VisualStateGroups>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Padding="0"
                           Margin="0,0,0,15"
                           CornerRadius="20"
                           BorderColor="Transparent">

                        <Grid HeightRequest="350">

                            <Image Source="{Binding ImageUrl}"
                                   Aspect="AspectFill"/>

                            <BoxView Color="Black"
                                     Opacity="0.35"/>

                            <VerticalStackLayout Padding="20"
                                                 VerticalOptions="End">

                                <Label Text="{Binding TitleWithDate}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       MaxLines="2"/>

                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="White"
                                       MaxLines="3"/>

                                <Button Text="Save"
                                        Clicked="SaveButton_Clicked"
                                        BackgroundColor="#003c92"
                                        TextColor="White"
                                        HorizontalOptions="Start"/>

                            </VerticalStackLayout>

                        </Grid>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>